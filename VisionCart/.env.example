# ─────────────────────────────────────────────
# VisionCart – Environment Configuration
# Copy to .env and fill in secrets
# ─────────────────────────────────────────────

# ── Database ────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./visioncart.db
DATABASE_URL_SYNC=sqlite:///./visioncart.db

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── WebRTC / TURN ─────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# ── AI / CV ───────────────────────────────────
AI_MODEL_PATH=./ai-engine/models/
FRESHNESS_THRESHOLD=0.65
YOLO_CONFIDENCE=0.5
YOLO_NMS_THRESHOLD=0.4

# ── Whisper (Voice-to-Text) ───────────────────
WHISPER_API_KEY=
WHISPER_MODEL=base

# ── AWS (Production) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=visioncart-assets

# ── Budget ────────────────────────────────────
MAX_BUDGET_ALERT_PERCENT=90
DEFAULT_CURRENCY=USD

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
